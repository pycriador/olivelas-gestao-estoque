      "expectedResult": {
        "orderStatus": "DELIVERED",
        "stockDeduction": {
          "QA-AZE-001": 98,
          "QA-QUE-002": 97
        }
      }
    },
    {
      "id": "TC-07",
      "category": "Pedidos / Cancelamento",
