    {
      "id": "TC-06",
      "category": "PDV / Vendas",
      "name": "Executar Venda no PDV e Validar Dedução Atômica de Estoque",
      "route": "/sales",
      "action": "CREATE_POS_ORDER",
      "payload": {
        "items": [
          { "sku": "QA-AZE-001", "quantity": 2 },
          { "sku": "QA-QUE-002", "quantity": 3 }
        ],
        "discount_amount": 5.00,
        "payment_method": "PIX"
